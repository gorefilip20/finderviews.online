# Hostinger Node.js application environment
NODE_ENV=production
PORT=3000

# Copy the pooled PostgreSQL connection string from the Neon dashboard.
# It normally starts with postgresql:// and includes sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@EP-EXAMPLE-REGION.aws.neon.tech/DBNAME?sslmode=require

# Generate a long random value; do not reuse a database or OAuth password.
JWT_SECRET=replace-with-a-long-random-secret

# Values supplied by the Manus OAuth application configuration.
VITE_APP_ID=replace-with-your-app-id
OAUTH_SERVER_URL=https://oauth.manus.im

# Optional owner/admin mapping and AI brief support.
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional licensed providers and outbound email.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
THEIRSTACK_API_KEY=
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
