# ---------------------------------------------------------------------------
# Finder / Finderviews environment
#
# Nothing here is required to boot. Features whose credential is missing report
# themselves as "not connected" in the UI rather than failing or showing
# placeholder data. Copy to .env and fill in what you want switched on.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://finderviews.online

# --- Storage -----------------------------------------------------------------
# Required for: saving prospects, pipeline, watchlists, proposals, team seats.
# Without it, discovery and the single-site audit still work.
# After setting this, run: pnpm db:push
DATABASE_URL=mysql://user:password@host:3306/finder

# --- Sessions and sign-in ----------------------------------------------------
# JWT_SECRET signs the session cookie. Use a long random string.
JWT_SECRET=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=
OAUTH_CLIENT_SECRET=
# Open id of the account granted the admin role on first sign-in.
OWNER_OPEN_ID=

# --- AI (optional) -----------------------------------------------------------
# Powers the hiring brief and the proposal's opening copy. Every other part of a
# proposal - audit, scope, pricing - is generated without it.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Prospecting sources (optional) ------------------------------------------
# Public business listings. Powers Rising Under-Built, Decaying web presence,
# the ad-spend finder and partnership matching.
PLACES_API_KEY=

# Confirms a business is actively paying to advertise.
META_AD_LIBRARY_TOKEN=

# Newly registered / newly opened businesses. Point at any JSON registry that
# accepts ?location= and ?since_days= and returns { records: [...] }.
BUSINESS_REGISTRY_API_URL=
BUSINESS_REGISTRY_API_KEY=

# Local and on-site jobs. The built-in Jobicy feed is remote-only, so local
# hiring signals need this. Accepts ?what= ?where= ?max_days_old=.
LOCAL_JOBS_API_URL=
LOCAL_JOBS_API_KEY=

# --- Weekly digest email (optional) ------------------------------------------
RESEND_API_KEY=
DIGEST_FROM_EMAIL=finder@finderviews.online
# Shared secret required by POST /api/cron/digest, sent as the x-cron-secret header.
CRON_SECRET=
